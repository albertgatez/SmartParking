# Copia este archivo como .env (en la misma carpeta que gateway.py) y llena los valores.
# El archivo .env NO se debe subir al repositorio.

SERIAL_PUERTO=/dev/ttyACM0
SERIAL_BAUDIOS=9600

MQTT_BROKER=localhost
MQTT_PUERTO=1883
# Usuario y contraseña creados con mosquitto_passwd (ver mosquitto/README.md)
MQTT_USUARIO=gateway
MQTT_PASSWORD=
MQTT_PREFIJO=smartparking

SUPABASE_URL=https://kjbmwwbzdsvunzndeusf.supabase.co
# Llave con permiso para actualizar Cajon y leer Reserva (ver README)
SUPABASE_KEY=

INTERVALO_RESERVAS_S=5
INTERVALO_REINTENTO_S=5
LOG_NIVEL=INFO
