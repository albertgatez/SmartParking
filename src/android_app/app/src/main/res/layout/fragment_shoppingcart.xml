<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Layout cuando NO hay reserva -->
        <LinearLayout
            android:id="@+id/layoutSinReserva"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_empty_cart"
                android:contentDescription="Carrito vacío"
                app:tint="#CCCCCC"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No hay reservas pendientes de pago"
                android:textSize="16sp"
                android:textColor="@color/app_text_secondary"
                android:gravity="center" />

        </LinearLayout>

        <!-- Layout cuando HAY reserva activa -->
        <LinearLayout
            android:id="@+id/layoutReservaActiva"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="visible">

            <!-- Temporizador -->
            <TextView
                android:id="@+id/tvTemporizador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tiempo restante: 04:44 min"
                android:textSize="14sp"
                android:textColor="#F44336"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="12dp"
                android:background="@drawable/bg_temporizador"
                android:layout_marginBottom="16dp" />

            <!-- Horario -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="Horario"
                        android:textSize="14sp"
                        android:textColor="@color/app_text_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHorario"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="$25.50/hr | Estándar\n16:00 - 18:59 | 3 horas"
                        android:textSize="14sp"
                        android:textColor="@color/app_text_secondary" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Método de pago -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">

                <!-- Toda la fila abre Perfil > Métodos de pago -->
                <LinearLayout
                    android:id="@+id/filaMetodoPago"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="PAGO"
                        android:textSize="14sp"
                        android:textColor="@color/app_text_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMetodoPago"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Cargando..."
                        android:textSize="14sp"
                        android:textColor="@color/app_text_secondary" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="Ver métodos de pago"
                        app:tint="#CCCCCC" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Cupón de descuento -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PROMOCIONES"
                        android:textSize="14sp"
                        android:textColor="@color/app_text_primary"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <EditText
                            android:id="@+id/etCupon"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Aplicar código de promoción"
                            android:textSize="14sp"
                            android:background="@null"
                            android:padding="8dp" />

                        <Button
                            android:id="@+id/btnAplicarCupon"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Aplicar"
                            android:textSize="12sp"
                            android:backgroundTint="@color/app_action"
                            android:textColor="#FFFFFF"
                            style="?android:attr/borderlessButtonStyle" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCuponAplicado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="@color/app_success_text"
                        android:visibility="gone"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Descripción de la reserva -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reserva"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/app_text_primary"
                android:layout_marginBottom="12dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvNombreEstacionamiento"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Forum Tlaquepaque"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/app_text_primary"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvSeccionCajon"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Sección: A"
                            android:textSize="12sp"
                            android:textColor="@color/app_text_secondary"
                            android:layout_marginBottom="2dp" />

                        <TextView
                            android:id="@+id/tvPrecioPorHora"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Lugar: 4"
                            android:textSize="12sp"
                            android:textColor="@color/app_text_secondary" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTipoCajon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$25.50"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/app_text_primary"
                        android:layout_gravity="center_vertical" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Resumen de precios -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/app_surface_variant"
                android:layout_marginVertical="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Subtotal (2)"
                    android:textSize="14sp"
                    android:textColor="@color/app_text_secondary" />

                <TextView
                    android:id="@+id/tvSubtotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$76.50"
                    android:textSize="14sp"
                    android:textColor="@color/app_text_secondary" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Comisión 4%"
                    android:textSize="14sp"
                    android:textColor="@color/app_text_secondary" />

                <TextView
                    android:id="@+id/tvComision"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$3.06"
                    android:textSize="14sp"
                    android:textColor="@color/app_text_secondary" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/app_text_primary" />

                <TextView
                    android:id="@+id/tvTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$79.56"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/app_text_primary" />

            </LinearLayout>

            <!-- Botón confirmar pago -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmarPago"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                style="@style/Widget.SmartParking.BotonPrincipal"
                android:text="Continuar al pago"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="28dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>