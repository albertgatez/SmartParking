<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/app_background"
    tools:context=".pagos.MetodosPagoActivity">

    <!-- Título -->
    <TextView
        android:id="@+id/txtMetodosTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Métodos de pago"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingBottom="4dp"
        android:textColor="@color/app_text_primary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tus tarjetas se guardan de forma segura en Stripe."
        android:textSize="14sp"
        android:paddingBottom="10dp"
        android:textColor="@color/app_text_secondary" />

    <!-- Línea divisoria -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/app_border"
        android:layout_marginBottom="10dp" />

    <!-- Contenido: lista, vacío, error o carga -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMetodos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            tools:listitem="@layout/item_metodo_pago" />

        <TextView
            android:id="@+id/txtSinTarjetas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="No tienes tarjetas guardadas"
            android:textSize="16sp"
            android:textColor="@color/app_text_secondary"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="No se pudieron cargar tus tarjetas."
                android:textSize="15sp"
                android:textColor="#B03A2E" />

            <Button
                android:id="@+id/btnReintentar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/app_surface_variant"
                android:text="Reintentar"
                android:textColor="@color/app_accent_text" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressCarga"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAgregarTarjeta"
        style="@style/Widget.SmartParking.BotonPrincipal"
        app:backgroundTint="@color/sp_primary_blue"
        android:layout_width="match_parent"
        android:layout_marginTop="8dp"
        android:text="Agregar tarjeta" />

</LinearLayout>
