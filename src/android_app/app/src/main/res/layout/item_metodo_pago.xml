<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/app_surface"
    app:cardCornerRadius="14dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:id="@+id/filaMetodo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:padding="16dp">

        <!-- Solo en modo selección: indica con qué tarjeta se va a pagar -->
        <RadioButton
            android:id="@+id/radioSeleccion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Marca + etiqueta de predeterminada -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtMarca"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Visa"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:textColor="@color/app_text_primary" />

                <TextView
                    android:id="@+id/txtPredeterminada"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="#D5F5E3"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="Predeterminada"
                    android:textColor="#1E8449"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Últimos 4 dígitos -->
            <TextView
                android:id="@+id/txtNumero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="•••• 4242"
                android:textSize="16sp"
                android:textColor="@color/app_accent_text" />

            <!-- Vencimiento -->
            <TextView
                android:id="@+id/txtVencimiento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Vence 12/28"
                android:textSize="14sp"
                android:textColor="@color/app_text_secondary" />

            <!-- Solo aparece en las tarjetas que no son la predeterminada -->
            <TextView
                android:id="@+id/btnPredeterminar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="?attr/selectableItemBackground"
                android:minHeight="32dp"
                android:gravity="center_vertical"
                android:text="Usar como predeterminada"
                android:textColor="@color/app_action"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnEliminar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Eliminar tarjeta"
            android:src="@drawable/ic_eliminar"
            app:tint="#B03A2E" />
    </LinearLayout>

</androidx.cardview.widget.CardView>