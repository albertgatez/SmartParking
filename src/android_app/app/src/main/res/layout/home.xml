<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- Contenedor principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Encabezado -->

        <!-- Lista de estacionamientos -->

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="229dp"
            android:adjustViewBounds="false"
            android:baselineAlignBottom="false"
            android:textAlignment="textEnd"
            app:srcCompat="@mipmap/car01" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <TextView
                android:id="@+id/txtTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Estacionamientos disponibles"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- CARD DE ESTACIONAMIENTO -->
                <LinearLayout
                    android:id="@+id/cardParking"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_bg"
                    android:padding="18dp"
                    android:orientation="vertical"
                    android:layout_marginBottom="15dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/txtNombreParking"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Parking Central"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtDireccion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Av. Centro #123"
                            android:textColor="#606060"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="Detalles"
                            android:textColor="#222"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/imageView3"
                            android:layout_width="match_parent"
                            android:layout_height="159dp"
                            app:srcCompat="@mipmap/car02" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/textView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Detalles"
                        android:textColor="#222"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textView4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Acceso 24/7\n• CCTV activo\n• Entrada especial para motos\n• Altura máxima 2.1 m"
                        android:textColor="#555"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtTarifa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$20 por hora"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="10dp" />

                    <Button
                        android:id="@+id/btnReservar"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="RESERVAR"
                        android:layout_marginTop="15dp"
                        android:textColor="@android:color/white"
                        android:backgroundTint="#0095FF"
                        android:textAllCaps="true" />

                </LinearLayout>
            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <!-- MENÚ INFERIOR -->

</RelativeLayout>
