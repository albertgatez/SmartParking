<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true"
    tools:context=".pagos.AgregarTarjetaActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agregar tarjeta"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="4dp"
            android:textColor="#2E2E2E" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Los datos de tu tarjeta los recibe y guarda Stripe; la app no los almacena."
            android:textSize="14sp"
            android:paddingBottom="10dp"
            android:textColor="#555555" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginBottom="16dp" />

        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="true">

            <!-- Formulario de Stripe: número, vencimiento, CVC y código postal.
                 Limita los dígitos según la marca y muestra los errores en español. -->
            <com.stripe.android.view.CardMultilineWidget
                android:id="@+id/cardWidget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="El código postal debe tener 5 dígitos."
            android:textSize="13sp"
            android:textColor="#777777" />

        <ProgressBar
            android:id="@+id/progressGuardar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnGuardarTarjeta"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#0095FF"
            android:text="Guardar tarjeta"
            android:textAllCaps="true"
            android:textColor="@android:color/white" />

    </LinearLayout>
</ScrollView>
